{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Microsoft Teams",
  "version": "1.0.0",
  "identifier": "com.github.msteams.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Microsoft Teams desktop client",
    "longDescription": "An unofficial desktop wrapper for Microsoft Teams built with Tauri.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
